# Operational baseline for this fork.
# Do not place passwords, tokens, private keys or certificates in this file.
#
# Host IPv4 is intentionally left blank. Start the stack with `sh start.sh`; it detects the
# current LAN IPv4 selected by the host's routing table and exports it to Docker Compose.
# To force a specific address for one run:
#   IPADDRESS=192.168.1.244 sh start.sh

# Host / Stremio
IPADDRESS=
SERVER_URL=
STREMIO_DATA_DIR=stremio-cache
STREMIOSRV_BT_LISTEN_PORT=6881
CERT_FILE=certificates.pem
STREMIO_UPDATE_HEALTH_TIMEOUT=180

# Stremio Cache / Library Addon
STREMIOSRV_LIBRARY_UI=true
STREMIOSRV_LIBRARY_ALLOW_HTTP=false
STREMIOSRV_LIBRARY_OWNER=
# Empty uses the built-in private-network ranges (including 192.168.0.0/16).
STREMIOSRV_LIBRARY_ADDON_ALLOW=

# Transcoding baseline
TRANSCODING_MODE=auto
TRANSCODING_HWACCEL=vaapi
VAAPI_DEVICE=/dev/dri/renderD128
TRANSCODING_VIDEO_CODEC=h264_vaapi
TRANSCODING_VIDEO_QUALITY=22
TRANSCODING_AUDIO_CODEC=aac
TRANSCODING_AUDIO_BITRATE=192k
TRANSCODING_COPY_VIDEO=true
TRANSCODING_COPY_AUDIO=true
TRANSCODING_DIRECT_VIDEO_CODECS=h264
TRANSCODING_DIRECT_AUDIO_CODECS=aac,mp3,ac3
TRANSCODING_FALLBACK_CODEC=libx264
TRANSCODING_HW_DECODE=true

# Pi-hole
TZ=Africa/Luanda
PIHOLE_PASSWORD=
# start.sh binds these to the detected host IPv4 unless explicitly exported by the operator.
PIHOLE_WEB_BIND_IP=
PIHOLE_WEB_PORT=8053
PIHOLE_UPSTREAM_DNS=1.1.1.1;1.0.0.1
PIHOLE_DNS_BIND_IP=
PIHOLE_DNS_PORT=53
